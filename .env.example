# DailyQuest Supabase Configuration (Free Tier)
# Obtain these from your Supabase Project Settings -> API (https://supabase.com/dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (Optional - used for privileged operations like account deletion)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
